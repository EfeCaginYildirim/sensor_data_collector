# ============================================================
# Data Collection Scheduler - Configuration Template
# ============================================================
# SETUP INSTRUCTIONS:
#   1. Copy this file: cp scheduler_config.properties.example scheduler_config.properties
#   2. Fill in YOUR values below (replace all YOUR_* placeholders)
#   3. scheduler_config.properties is in .gitignore — it will NOT be committed
# ============================================================


# --- Scheduling ---
# Time of day to run daily collection (24h format HH:mm)
daily_run_time=09:00

# How often to repeat data collection (in minutes)
repeat_interval_minutes=1440

# Delay before the first run (in minutes, 0 = run immediately)
initial_delay_minutes=0

# How many days back to fetch on first/reset run
safe_data_range_days=3

# Start date for the very first historical data pull (YYYY-MM-DD)
initial_data_start_date=2024-01-01


# --- Last Run Tracking ---
enable_last_run_tracking=true


# --- Database Settings ---
# SQL Server JDBC connection string
db_url=jdbc:sqlserver://localhost:1433;databaseName=YOUR_DB_NAME;encrypt=true;trustServerCertificate=true;
db_user=YOUR_DB_USERNAME
db_password=YOUR_DB_PASSWORD


# --- External API Settings ---
# Replace with the base URL supplied by your API provider.
api_base_url=https://api.example.com/v1
api_username=YOUR_API_USERNAME
api_password=YOUR_API_PASSWORD


# --- Plant & Monitor IDs ---
# Your plant ID (supplied by your API provider)
plant_id=YOUR_PLANT_ID

# Comma-separated list of monitor IDs to collect data for
monitor_ids=YOUR_MONITOR_ID_1,YOUR_MONITOR_ID_2,YOUR_MONITOR_ID_3


# --- Output File Settings ---
output_directory=data_files/
json_file_prefix=combined_data_
create_timestamped_files=true


# --- Logging ---
enable_detailed_logging=true
log_to_file=true
log_file_directory=logs/
